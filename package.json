{
  "name": "parsea",
  "version": "0.10.2",
  "description": "parser combinator library for parsing ArrayLike.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./internal": "./dist/internal.js"
  },
  "scripts": {
    "build": "tsdown ./src/index.ts ./src/internal.ts --platform=neutral",
    "test": "vitest",
    "check": "biome check .",
    "spell": "cspell --no-progress ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uzmoi/parsea.git"
  },
  "keywords": [
    "parsing"
  ],
  "author": "uzmoi",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/uzmoi/parsea/issues"
  },
  "homepage": "https://github.com/uzmoi/parsea#readme",
  "dependencies": {
    "emnorst": "1.0.0-next.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@vitest/coverage-v8": "^4.1.10",
    "cspell": "^10.0.1",
    "lefthook": "^2.1.10",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
